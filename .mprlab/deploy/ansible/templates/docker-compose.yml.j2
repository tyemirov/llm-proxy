---
services:
  {{ mprlab_container_resource.name }}:
    image: {{ mprlab_deploy_image_ref }}
    container_name: {{ mprlab_container_resource.container_name }}
    restart: unless-stopped
    env_file:
      - ./{{ mprlab_container_resource.runtime_assets[0].destination }}
    expose:
{% for port in mprlab_container_resource.ports %}
      - "{{ port.container_port }}"
{% endfor %}
    volumes:
      - llm-proxy-data:/app/data
      - ./{{ mprlab_container_resource.runtime_assets[1].destination }}:/app/config.yml:ro
    networks:
      - default

networks:
  default:
    external: true
    name: {{ mprlab_container_resource.network }}

volumes:
  llm-proxy-data:
    name: {{ mprlab_container_resource.data_volume }}
