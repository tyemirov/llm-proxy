+	"github.com/tyemirov/llm-proxy/internal/testfixtures"
+	"go.uber.org/zap"
+)
+
+const gpt62SolModel = "gpt-6.2-sol"
+
+func TestGPT62SolCatalog(t *testing.T) {
+	catalog := testfixtures.ProviderCatalog(t)
+	public, err := proxy.NewPublicCapabilityCatalog(proxy.Configuration{ProviderCatalog: catalog})
+	if err != nil {
+		t.Fatal(err)
+	}
+	index := slices.IndexFunc(public.Offerings, func(offering proxy.PublicProviderOffering) bool {
+		return offering.Provider == "openai" && offering.Model == gpt62SolModel
+	})
+	if index < 0 {
+		t.Fatal("missing GPT-6.2 Sol offering")
+	}
+	offering := public.Offerings[index]
+	if !reflect.DeepEqual(offering.ReasoningEfforts, []string{"low", "medium", "high", "xhigh", "max"}) || !slices.Contains(offering.Capabilities, "image_input") || !slices.Contains(offering.Capabilities, "structured_output") {
+		t.Fatalf("offering=%+v", offering)
+	}
+	limits := map[string]int{}
+	for _, limit := range offering.Limits {
+		if limit.Value != nil {
+			limits[limit.ID] = *limit.Value
+		}
+	}
+	if limits["context_tokens"] != 1050000 || limits["input_tokens"] != 922000 || limits["output_tokens"] != 128000 {
+		t.Fatalf("limits=%v", limits)
+	}
+	server := httptest.NewServer(proxy.BuildPublicCapabilityRouter(public, "error"))
+	t.Cleanup(server.Close)
+	response, err := server.Client().Get(server.URL + proxy.PublicCapabilitiesPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(response.Body)
+	response.Body.Close()
+	if err != nil || response.StatusCode != http.StatusOK || !strings.Contains(string(body), gpt62SolModel) {
+		t.Fatalf("public discovery status=%d error=%v", response.StatusCode, err)
+	}
+	service, err := proxy.NewCatalogService(catalog.ModelCatalog())
+	if err != nil {
+		t.Fatal(err)
+	}
+	at := time.Date(2026, 11, 21, 12, 0, 0, 0, time.UTC)
+	for _, fixture := range []struct{ component, cache, short, long string }{
+		{"input_tokens", "", "2", "4"}, {"output_tokens", "", "10", "15"}, {"prompt_cache_read_tokens", "read", "0.1", "0.2"},
+	} {
+		for _, count := range []uint64{272000, 272001} {
+			want := fixture.short
+			if count > 272000 {
+				want = fixture.long
+			}
+			selected := service.SelectApplicablePrice("openai", gpt62SolModel, "text", fixture.component, proxy.CatalogPriceConditions{BillingMode: "standard", ServiceTier: "standard", CacheClass: fixture.cache}, count, at)
+			if !selected.Available || selected.Rate == nil || string(selected.Rate.Rate) != want {
+				t.Fatalf("%s input=%d selected=%+v want=%s", fixture.component, count, selected, want)
+			}
+		}
+	}
+	if selected := service.SelectApplicablePrice("openai", gpt62SolModel, "text", "prompt_cache_write_tokens", proxy.CatalogPriceConditions{BillingMode: "standard", ServiceTier: "standard", CacheClass: "write"}, 1, at); selected.Available {
+		t.Fatal("unspecified cache retention was assigned a price")
+	}
+}
+
+func TestGPT62SolHTTPStructuredImageAndRejections(t *testing.T) {
+	calls := 0
+	upstream := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		calls++
+		var payload map[string]any
+		if err := json.NewDecoder(request.Body).Decode(&payload); err != nil {
+			t.Error(err)
+			writer.WriteHeader(400)
+			return
+		}
+		if request.URL.Path != "/responses" || payload["model"] != gpt62SolModel || payload["store"] != true || payload["background"] != true || payload["max_output_tokens"] != float64(4096) {
+			t.Errorf("Responses payload=%v", payload)
+		}
+		if payload["reasoning"].(map[string]any)["effort"] != "medium" || payload["temperature"] != nil || payload["top_p"] != nil {
+			t.Error("reasoning or sampling policy differs")
+		}
+		content := payload["input"].([]any)[0].(map[string]any)["content"].([]any)
+		image := content[0].(map[string]any)
+		if image["type"] != "input_image" || image["image_url"] != "data:image/png;base64,"+base64.StdEncoding.EncodeToString([]byte("image/png")) {
+			t.Error("image bytes or placement differ")
+		}
+		format := payload["text"].(map[string]any)["format"].(map[string]any)
+		if format["type"] != "json_schema" || format["strict"] != true {
+			t.Error("strict structured schema not serialized")
+		}
+		writer.Header().Set("Content-Type", "application/json")
+		io.WriteString(writer, `{"status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"{\"answer\":\"yes\"}"}]}],"usage":{"input_tokens":120,"output_tokens":30,"total_tokens":150}}`)
+	}))
+	t.Cleanup(upstream.Close)
+	router, err := buildRouterWithCatalogs(t, proxy.Configuration{ProviderCatalog: testfixtures.ProviderCatalog(t), Endpoints: providerEndpointOverrides(map[string]string{"openai": upstream.URL}, nil), AssetStorePath: t.TempDir()}, zap.NewNop().Sugar())
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewServer(router)
+	t.Cleanup(server.Close)
+	discoveryRequest, err := http.NewRequest(http.MethodGet, server.URL+"/v1/models", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	discoveryRequest.Header.Set("Authorization", "Bearer "+TestSecret)
+	discoveryResponse, err := server.Client().Do(discoveryRequest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	discoveryBody, err := io.ReadAll(discoveryResponse.Body)
+	discoveryResponse.Body.Close()
+	if err != nil || discoveryResponse.StatusCode != http.StatusOK || !strings.Contains(string(discoveryBody), "openai/"+gpt62SolModel) || calls != 0 {
+		t.Fatalf("tenant route discovery status=%d calls=%d error=%v", discoveryResponse.StatusCode, calls, err)
+	}
+	base := map[string]any{"model": gpt62SolModel, "reasoning_effort": "medium", "max_tokens": 4096, "messages": []any{map[string]any{"role": "user", "content": "inspect", "attachments": []any{map[string]string{"type": "image", "mime_type": "image/png", "data": base64.StdEncoding.EncodeToString([]byte("image/png"))}}}}, "structured_output": map[string]any{"schema": map[string]any{"type": "object", "properties": map[string]any{"answer": map[string]string{"type": "string"}}, "required": []string{"answer"}, "additionalProperties": false}}}
+	for index, fixture := range []struct {
+		effort         string
+		tokens, status int
+	}{{"medium", 4096, 200}, {"none", 4096, 400}, {"minimal", 4096, 400}, {"medium", 128001, 400}} {
+		base["reasoning_effort"], base["max_tokens"] = fixture.effort, fixture.tokens
+		body, err := json.Marshal(base)
+		if err != nil {
+			t.Fatal(err)
+		}
+		request, err := http.NewRequest("POST", server.URL+"/v2?key="+TestSecret+"&provider=openai", strings.NewReader(string(body)))
+		if err != nil {
+			t.Fatal(err)
+		}
+		request.Header.Set("Content-Type", "application/json")
+		request.Header.Set("Idempotency-Key", []string{"gpt62-sol-medium", "gpt62-sol-none", "gpt62-sol-minimal", "gpt62-sol-limit"}[index])
+		response, err := server.Client().Do(request)
+		if err != nil {
+			t.Fatal(err)
+		}
+		actual, err := io.ReadAll(response.Body)
+		response.Body.Close()
+		if err != nil || response.StatusCode != fixture.status || calls != 1 {
+			t.Fatalf("case=%d status=%d calls=%d body=%s error=%v", index, response.StatusCode, calls, actual, err)
+		}
+		if fixture.status == 200 && (string(actual) != `{"answer":"yes"}` || response.Header.Get("X-LLM-Proxy-Request-Tokens") != "120" || response.Header.Get("X-LLM-Proxy-Response-Tokens") != "30") {
+			t.Fatalf("completion or usage differs: %s", actual)
+		}
+	}
+}
